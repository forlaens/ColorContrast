    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "analyze:assets": "node scripts/analyze-assets.mjs"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@siteimprove/alfa-playwright": "^0.84.2",
    "@siteimprove/alfa-refinement": "^0.119.0",
    "@siteimprove/alfa-test-utils": "^0.84.2",
    "@siteimprove/alfa-wcag": "^0.119.0",
