{
  "name": "color-contrast",
  "version": "1.0.0",
  "private": true,
  "description": "Image contrast checker web app.",
  "type": "module",
  "scripts": {
    "assets": "php scripts/generate-social-card.php",
    "dev": "node scripts/dev-server.mjs",
    "check": "node scripts/check.mjs",
    "test:html": "node --test test/html-validation.test.mjs",
    "test:structure": "node --test test/build-output.test.mjs test/i18n-coverage.test.mjs",
    "test:accessibility": "node --test --test-concurrency=1 test/alfa-accessibility.test.mjs",
    "test": "node --test --test-concurrency=1 test/alfa-accessibility.test.mjs test/build-output.test.mjs test/html-validation.test.mjs test/i18n-coverage.test.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "analyze:assets": "node scripts/analyze-assets.mjs"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@siteimprove/alfa-playwright": "^0.82.1",
    "@siteimprove/alfa-refinement": "^0.114.3",
    "@siteimprove/alfa-test-utils": "^0.82.1",
    "@siteimprove/alfa-wcag": "^0.114.3",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "esbuild": "^0.28.0",
    "html-validate": "^10.16.0",
    "ws": "^8.20.0"
  }
}
