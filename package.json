{
  "name": "color-contrast",
  "version": "1.0.0",
  "private": true,
  "description": "Image contrast checker web app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forlaens/ColorContrast.git"
  },
  "homepage": "https://colorcontrast.forlaens.com",
  "bugs": {
    "url": "https://github.com/forlaens/ColorContrast/issues"
  },
  "type": "module",
  "scripts": {
    "assets": "php scripts/generate-social-card.php",
    "dev": "node scripts/dev-server.mjs",
    "check": "node scripts/check.mjs",
    "test:html": "node --test test/html-validation.test.mjs",
    "test:structure": "node --test test/build-output.test.mjs test/i18n-coverage.test.mjs",
    "test:accessibility": "node --test --test-concurrency=1 test/alfa-accessibility.test.mjs",
